{
	"name": "@sonaraem/db",
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsc --noEmit",
		"db:push": "node scripts/ensure-pgvector.mjs && drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:mark-migrations-applied": "node scripts/mark-migrations-applied.mjs",
		"db:reset": "tsx scripts/db-reset.ts",
		"db:reset:all": "tsx scripts/db-reset.ts --all",
		"db:reset:embeddings": "tsx scripts/reset-embeddings.ts",
		"db:nuke": "node scripts/db-nuke.mjs",
		"db:seed": "tsx scripts/seed-admin.ts"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@sonaraem/env": "workspace:*",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"pg": "^8.23.0",
		"ws": "^8.21.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@sonaraem/config": "workspace:*",
		"@types/pg": "^8.23.1",
		"@types/ws": "^8.18.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.23.13",
		"typescript": "catalog:"
	}
}
