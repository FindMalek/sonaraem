# =============================================================================
# SONARAEM - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Neon or local Docker). Schema uses pgvector — local Docker
# image includes it (`pnpm db:setup`). For plain Postgres, enable the extension first or use Neon with pgvector.
SONARAEM_DATABASE_URL="postgresql://postgres:password@localhost:5433/sonaraem"

# Dev only — allow db:reset against non-localhost URLs (dangerous on shared DBs)
# SONARAEM_ALLOW_DB_RESET_REMOTE="true"

# Dev only — allow db:nuke when DATABASE_URL is not localhost:5433 (dangerous)
# SONARAEM_ALLOW_DB_NUKE="true"

# -----------------------------------------------------------------------------
# BASE CONFIGURATION
# -----------------------------------------------------------------------------
# Node environment (development, production, local)
NEXT_PUBLIC_SONARAEM_NODE_ENV="local"

# API URL - Base URL for API requests (auth, RPC)
# Required by: All apps. API runs on this URL.
NEXT_PUBLIC_SONARAEM_API_URL="http://127.0.0.1:3002"

# Allowed origin pattern for CORS validation (*, URL, or wildcard like *.domain.com)
NEXT_PUBLIC_SONARAEM_ALLOWED_ORIGIN="*"

# -----------------------------------------------------------------------------
# APPLICATION URLS
# -----------------------------------------------------------------------------
# Web app URL
NEXT_PUBLIC_SONARAEM_WEB_URL="http://127.0.0.1:3001"

# Dashboard app URL
NEXT_PUBLIC_SONARAEM_DASHBOARD_URL="http://127.0.0.1:3003"

# Admin app URL (internal tool, port 3004)
NEXT_PUBLIC_SONARAEM_ADMIN_URL="http://127.0.0.1:3004"

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Better Auth secret (generate with: openssl rand -base64 32)
SONARAEM_BETTER_AUTH_SECRET="your-secret-key-here-generate-with-openssl"

# Spotify OAuth (optional)
# Redirect URI: {NEXT_PUBLIC_SONARAEM_API_URL}/api/auth/callback/spotify
SONARAEM_SPOTIFY_CLIENT_ID=""
SONARAEM_SPOTIFY_CLIENT_SECRET=""

# Spotify Dev Mode allowlist automation (#290) — the dashboard account, not the OAuth app above.
# Session key: generate with `openssl rand -base64 32` (32 random bytes, base64).
SONARAEM_SPOTIFY_ALLOWLIST_SESSION_KEY=""

# -----------------------------------------------------------------------------
# AI / EMBEDDINGS (Optional)
# -----------------------------------------------------------------------------
SONARAEM_OPENAI_API_KEY=""

# @sonaraem/ai-provider pins each task to a fixed provider (packages/ai-provider/src/models.ts) — set whichever credential your tasks need.
SONARAEM_GROQ_API_KEY=""
SONARAEM_CONCENTRATE_API_KEY=""

# -----------------------------------------------------------------------------
# EMAIL (Transactional + Lifecycle)
# -----------------------------------------------------------------------------
# Resend API key used by server-side email tasks
SONARAEM_RESEND_API_KEY=""

# Verified sender identity in Resend (e.g. Sonaraem <hello@mail.sonaraem.app>)
SONARAEM_EMAIL_FROM=""

# Optional reply-to mailbox shown to recipients
SONARAEM_EMAIL_REPLY_TO=""

# Optional shared secret expected by /api/webhooks/resend endpoint
SONARAEM_RESEND_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# CRON (Optional)
# -----------------------------------------------------------------------------
# Secret for Vercel cron to trigger organize.run
SONARAEM_CRON_SECRET=""

# -----------------------------------------------------------------------------
# BACKGROUND JOBS (Trigger.dev)
# -----------------------------------------------------------------------------
# Secret key from your Trigger.dev project dashboard
# Get from: https://cloud.trigger.dev -> Project -> API Keys
# `pnpm trigger:dev` maps this to TRIGGER_SECRET_KEY for the Trigger CLI.
SONARAEM_TRIGGER_SECRET_KEY=""

# Project reference from your Trigger.dev project dashboard (required for `pnpm trigger:dev` unless skipped below)
# Get from: https://cloud.trigger.dev -> Project -> Settings
SONARAEM_TRIGGER_PROJECT_REF=""

# Set to true to skip the Trigger.dev worker when the project ref is unset (API/dashboard/web still run; background jobs won’t)
# SONARAEM_TRIGGER_DEV_SKIP="true"

# Personal Access Token for `pnpm deploy:trigger` (pushes task code to Trigger.dev's infra).
# Different credential from SONARAEM_TRIGGER_SECRET_KEY above — generate from your
# Trigger.dev profile -> Personal Access Tokens, not the project's API Keys page.
# SONARAEM_TRIGGER_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
SONARAEM_OTEL_SERVICE_NAME="sonaraem"
SONARAEM_OTEL_SAMPLING_RATE="1"
SONARAEM_OTEL_ENABLED="false"
SONARAEM_OTEL_EXPORTER_OTLP_ENDPOINT=""
SONARAEM_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=""
SONARAEM_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=""
SONARAEM_OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=""
SONARAEM_OTEL_EXPORTER_OTLP_HEADERS=""
SONARAEM_OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
SONARAEM_OTEL_EXPORTER_OTLP_COMPRESSION="gzip"
