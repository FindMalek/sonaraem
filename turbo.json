{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"SKIP_ENV_VALIDATION",
		"SONARAEM_DATABASE_URL",
		"NEXT_PUBLIC_SONARAEM_NODE_ENV",
		"NEXT_PUBLIC_SONARAEM_API_URL",
		"NEXT_PUBLIC_SONARAEM_ALLOWED_ORIGIN",
		"SONARAEM_BETTER_AUTH_SECRET",
		"NEXT_PUBLIC_SONARAEM_WEB_URL",
		"NEXT_PUBLIC_SONARAEM_DASHBOARD_URL",
		"NEXT_PUBLIC_SONARAEM_ADMIN_URL",
		"SONARAEM_SPOTIFY_CLIENT_ID",
		"SONARAEM_SPOTIFY_CLIENT_SECRET",
		"SONARAEM_OPENAI_API_KEY",
		"SONARAEM_GROQ_API_KEY",
		"SONARAEM_CONCENTRATE_API_KEY",
		"SONARAEM_RESEND_API_KEY",
		"SONARAEM_EMAIL_FROM",
		"SONARAEM_EMAIL_REPLY_TO",
		"SONARAEM_RESEND_WEBHOOK_SECRET",
		"SONARAEM_CRON_SECRET",
		"SONARAEM_OTEL_SERVICE_NAME",
		"SONARAEM_OTEL_SAMPLING_RATE",
		"SONARAEM_OTEL_ENABLED",
		"SONARAEM_OTEL_EXPORTER_OTLP_ENDPOINT",
		"SONARAEM_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
		"SONARAEM_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT",
		"SONARAEM_OTEL_EXPORTER_OTLP_LOGS_ENDPOINT",
		"SONARAEM_OTEL_EXPORTER_OTLP_HEADERS",
		"SONARAEM_OTEL_EXPORTER_OTLP_PROTOCOL",
		"SONARAEM_OTEL_EXPORTER_OTLP_COMPRESSION",
		"SONARAEM_ALLOW_DB_RESET_REMOTE",
		"SONARAEM_ALLOW_DB_NUKE"
	],
	"globalPassThroughEnv": [
		"SKIP_ENV_VALIDATION",
		"SONARAEM_DATABASE_URL",
		"NEXT_PUBLIC_SONARAEM_NODE_ENV",
		"NEXT_PUBLIC_SONARAEM_API_URL",
		"NEXT_PUBLIC_SONARAEM_ALLOWED_ORIGIN",
		"SONARAEM_BETTER_AUTH_SECRET",
		"NEXT_PUBLIC_SONARAEM_WEB_URL",
		"NEXT_PUBLIC_SONARAEM_DASHBOARD_URL",
		"NEXT_PUBLIC_SONARAEM_ADMIN_URL",
		"SONARAEM_SPOTIFY_CLIENT_ID",
		"SONARAEM_SPOTIFY_CLIENT_SECRET",
		"SONARAEM_OPENAI_API_KEY",
		"SONARAEM_GROQ_API_KEY",
		"SONARAEM_CONCENTRATE_API_KEY",
		"SONARAEM_RESEND_API_KEY",
		"SONARAEM_EMAIL_FROM",
		"SONARAEM_EMAIL_REPLY_TO",
		"SONARAEM_RESEND_WEBHOOK_SECRET",
		"SONARAEM_CRON_SECRET",
		"SONARAEM_OTEL_SERVICE_NAME",
		"SONARAEM_OTEL_SAMPLING_RATE",
		"SONARAEM_OTEL_ENABLED",
		"SONARAEM_OTEL_EXPORTER_OTLP_ENDPOINT",
		"SONARAEM_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
		"SONARAEM_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT",
		"SONARAEM_OTEL_EXPORTER_OTLP_LOGS_ENDPOINT",
		"SONARAEM_OTEL_EXPORTER_OTLP_HEADERS",
		"SONARAEM_OTEL_EXPORTER_OTLP_PROTOCOL",
		"SONARAEM_OTEL_EXPORTER_OTLP_COMPRESSION",
		"SONARAEM_ALLOW_DB_RESET_REMOTE",
		"SONARAEM_ALLOW_DB_NUKE"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**"]
		},
		"email#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"cache": false
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:mark-migrations-applied": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:reset": {
			"cache": false
		},
		"db:reset:all": {
			"cache": false
		},
		"db:reset:embeddings": {
			"cache": false
		},
		"db:nuke": {
			"cache": false
		},
		"db:seed": {
			"cache": false
		},
		"db:ops:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:ops:generate": {
			"cache": false
		},
		"db:ops:status": {
			"cache": false
		}
	}
}
